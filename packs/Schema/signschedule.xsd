<?xml version="1.0" encoding="utf-8"?>
<!--
  SignCore sign-schedule schema (XML only, no target namespace).

  This is the canonical schedule document: the shape ScheduleXmlExporter writes and
  XmlSignScheduleImporter reads. Both <sign-schedule> and the camelCase alias
  <signSchedule> are declared because the importer accepts either root.

  The importer stays deliberately more permissive than this schema (hyphen and
  underscore attribute aliases are interchangeable, background/scheme/variant default
  when absent, unknown attributes and elements are ignored) so third party exports
  keep working. Use this schema to check SignCore's own output and hand authored
  schedules.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="kindToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="stack"/>
      <xs:enumeration value="map-crossroads"/>
      <xs:enumeration value="map-tee"/>
      <xs:enumeration value="map-roundabout"/>
      <xs:enumeration value="direction"/>
      <xs:enumeration value="confirmatory"/>
      <xs:enumeration value="place-id"/>
      <xs:enumeration value="lane"/>
      <xs:enumeration value="information"/>
      <xs:enumeration value="diversion"/>
      <!-- S12a: the Warning / Regulatory / Supplementary family tokens (canonical SignKind
           spellings the CSV and XML exporters share through SignCore.Model.ScheduleCodec). -->
      <xs:enumeration value="warning"/>
      <xs:enumeration value="regulatory-prohibitory"/>
      <xs:enumeration value="regulatory-mandatory"/>
      <xs:enumeration value="stop"/>
      <xs:enumeration value="give-way"/>
      <xs:enumeration value="supplementary"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Vol.1 §B sign classification carried on a schedule row (S12a). -->
  <xs:simpleType name="classToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="warning"/>
      <xs:enumeration value="regulatory"/>
      <xs:enumeration value="guidance"/>
      <xs:enumeration value="information"/>
      <xs:enumeration value="supplementary"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- W/R symbol handedness read back from the sign-page third digit (Vol.1 p.8). -->
  <xs:simpleType name="mirrorToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="left"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Side of the road a located sign stands on (looking up-station). -->
  <xs:simpleType name="sideToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="right"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- App.3 §5 information-plate template. -->
  <xs:simpleType name="infoTemplateToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="service-panel"/>
      <xs:enumeration value="symbol-plate"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- App.1 §2.1.3 embedded symbol geometry within a guidance panel. -->
  <xs:simpleType name="embeddedTypeToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="warning-triangle"/>
      <xs:enumeration value="regulatory-roundel"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="approachToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="primary"/>
      <xs:enumeration value="secondary"/>
      <xs:enumeration value="local"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="colourToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="white"/>
      <xs:enumeration value="black"/>
      <xs:enumeration value="green"/>
      <xs:enumeration value="blue"/>
      <xs:enumeration value="brown"/>
      <xs:enumeration value="yellow"/>
      <xs:enumeration value="red"/>
      <xs:enumeration value="grey"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="schemeToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/>
      <xs:enumeration value="primary"/>
      <xs:enumeration value="secondary"/>
      <xs:enumeration value="information"/>
      <xs:enumeration value="tourist"/>
      <xs:enumeration value="temporary"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="variantToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="primary"/>
      <xs:enumeration value="secondary"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="directionToken">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ahead"/>
      <xs:enumeration value="left"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="destinationType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="direction" type="directionToken" use="required"/>
    <!-- Proximity rank within the direction; 0 is nearer (App.1 §2.1.2). -->
    <xs:attribute name="order" type="xs:int" use="optional" default="0"/>
    <xs:attribute name="symbol" type="xs:string" use="optional"/>
    <xs:attribute name="distance" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="scheduleType">
    <xs:sequence>
      <xs:element ref="sign" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="standard" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="embeddedType">
    <xs:attribute name="symbol-id" type="xs:string" use="required"/>
    <xs:attribute name="type" type="embeddedTypeToken" use="required"/>
  </xs:complexType>

  <xs:complexType name="signType">
    <xs:sequence>
      <xs:element ref="destination" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element ref="embedded" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="code" type="xs:string" use="required"/>
    <xs:attribute name="kind" type="kindToken" use="required"/>
    <xs:attribute name="speed-kph" type="xs:int" use="required"/>
    <xs:attribute name="approach-class" type="approachToken" use="required"/>
    <xs:attribute name="background" type="colourToken" use="optional" default="green"/>
    <xs:attribute name="scheme" type="schemeToken" use="optional"/>
    <xs:attribute name="variant" type="variantToken" use="optional"/>
    <!-- S12a: optional family / classification fields so a row round-trips every
         catalog-inserted value. All optional → older schedules stay valid. -->
    <xs:attribute name="symbol" type="xs:string" use="optional"/>
    <xs:attribute name="catalog-key" type="xs:string" use="optional"/>
    <xs:attribute name="class" type="classToken" use="optional"/>
    <xs:attribute name="info-template" type="infoTemplateToken" use="optional"/>
    <xs:attribute name="info-arrow" type="directionToken" use="optional"/>
    <xs:attribute name="info-distance" type="xs:string" use="optional"/>
    <xs:attribute name="mirror" type="mirrorToken" use="optional"/>
    <xs:attribute name="text-lines" type="xs:int" use="optional"/>
    <!-- Location along a road alignment (all optional): station and offset in metres,
         offset + right / - left looking up-station; side = left | right | both. -->
    <xs:attribute name="alignment" type="xs:string" use="optional"/>
    <xs:attribute name="station" type="xs:double" use="optional"/>
    <xs:attribute name="offset" type="xs:double" use="optional"/>
    <xs:attribute name="side" type="sideToken" use="optional"/>
  </xs:complexType>

  <xs:element name="sign-schedule" type="scheduleType"/>
  <xs:element name="signSchedule" type="scheduleType"/>
  <xs:element name="sign" type="signType"/>
  <xs:element name="destination" type="destinationType"/>
  <xs:element name="embedded" type="embeddedType"/>

</xs:schema>
