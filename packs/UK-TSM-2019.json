                   "source": "TSM Chapter 4 Appendix A column 2 (height of triangular warning signs); TSRGD 2016 Schedule 2 Part 2 prescribed sizes" } },
      { "key": "D512", "name": "Bend ahead (TSRGD diagram 512)", "family": "warning", "series": "D", "scheme": "secondary", "symbolId": "512",
        "diagram": "512", "citation": "TSRGD 2016 Schedule 2 Part 2 item 8",
