# Where things are in the repository. The ONLY place the packaging scripts learn this; the workflow
# repeats the two values it needs in its top-level env block (see installers.yml, "Repository layout").
# Sourced by stage.sh. Plain NAME=value lines, no spaces around "=".
#
# REPO_ROOT_REL  from this packaging folder up to the folder that holds packs/ and fonts/
# PACKS_REL      rule packs folder, relative to that root
# FONTS_REL      fonts folder, relative to that root
#
# The repository root holds afrobim/, packs/ and fonts/. Packaging lives at afrobim/packaging, so the
# root is two levels up: REPO_ROOT_REL=../.. (it would be .. if the workspace moved to the root).
REPO_ROOT_REL=../..
PACKS_REL=packs
FONTS_REL=fonts
